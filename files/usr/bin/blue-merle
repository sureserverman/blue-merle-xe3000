#!/bin/sh

# blue-merle CLI for GL-XE3000 (Puli AX)

. /lib/blue-merle/functions.sh

# Check IMEI write support on this RM520N-GL
imei_supported=0
if bm_can_write_imei; then
	imei_supported=1
else
	echo "NOTE: IMEI change is not supported on this modem firmware."
	echo "      IMEI/IMSI read, RF off, and shutdown are still available."
	echo
fi

echo -n "Swap SIM card and update IMEI? (Y/n): "
read answer
case $answer in
	n*|N*) exit 0;;
esac

old_imei=$(READ_IMEI)
old_imsi=$(READ_IMSI)

echo "Disabling RF..."
answer=1
while [ "$answer" -eq 1 ]; do
	gl_modem -B $BM_MODEM_BUS AT AT+CFUN=4 | grep -q OK
	if [ $? -ne 0 ]; then
		echo -n "...failed. Try again? (Y/n): "
		read answer
		case $answer in
			n*|N*) exit 1;;
			*) answer=1;;
		esac
	else
		answer=0
	fi
done

# Set interim random IMEI to prevent IMSI leak under old IMEI
if [ "$imei_supported" -eq 1 ]; then
	python3 /lib/blue-merle/imei_generate.py -r
fi

echo -n "Replace the SIM card now, then press Enter. "
read answer

leak=0
until gl_modem -B $BM_MODEM_BUS AT AT+CFUN=0 | grep -q OK; do
	sleep 1
	echo "CFUN=0 failed. Trying again."
done

until gl_modem -B $BM_MODEM_BUS AT AT+CFUN=4 | grep -q OK; do
	leak=1
	echo "CFUN=4 failed. Trying again."
done

if [ $leak -eq 1 ]; then
	echo
	echo "WARNING: Reset took longer than expected."
	echo
fi

sleep 1
new_imsi=$(READ_IMSI)

if [ "$old_imsi" = "$new_imsi" ]; then
	echo
	echo "WARNING: Old IMSI equals new IMSI."
	echo
fi

if [ "$imei_supported" -eq 1 ]; then
	echo -n "Random (r) or deterministic (d) IMEI? (R/d): "
	read answer
	case $answer in
		d*|D*) python3 /lib/blue-merle/imei_generate.py -d;;
		*)     python3 /lib/blue-merle/imei_generate.py -r;;
	esac

	new_imei=$(READ_IMEI)
	if [ "$old_imei" = "$new_imei" ]; then
		echo "WARNING: Old IMEI equals new IMEI."
	else
		mkdir -p /tmp/modem.1-1.2
		echo "$new_imei" > /tmp/modem.1-1.2/modem-imei
		if [ -d /root/esim ]; then
			echo "$new_imei" > /root/esim/imei
			shred -u /root/esim/log.txt 2>/dev/null
		fi
	fi
else
	echo "Skipping IMEI change (not supported on this modem)."
fi

echo
echo "For extra privacy, shutdown and change location before booting."
echo -n "Shutdown (s) or reset modem (m)? (S/m): "
read answer
case $answer in
	m*|M*)
		echo "Resetting modem..."
		until gl_modem -B $BM_MODEM_BUS AT AT+QPOWD | grep -q OK; do
			echo "Reset failed. Trying again."
			sleep 1
		done
		time_start=$(date +%s)
		until READ_IMSI >/dev/null 2>&1; do
			time_now=$(date +%s)
			printf "Waiting for reset... (%ds/30s)\r" "$((time_now-time_start))"
			sleep 1
		done
		echo
		echo "Done."
		;;
	*)
		echo "Shutting down..."
		/sbin/poweroff
		;;
esac
