#!/bin/sh

# blue-merle switch stage 1 for GL-XE3000 (Puli AX)

. /lib/blue-merle/functions.sh

if [ ! -f "/tmp/sim_change_start" ]; then
	echo 0 > /tmp/sim_change_start
fi

if [ ! -f "/tmp/sim_change_switch" ]; then
	sim_switch off
fi

now=$(date +%s)
sim_change_last=$(cat /tmp/sim_change_start)
sim_change_diff=$((now-sim_change_last))

if [ "$sim_change_diff" -lt 60 ]; then
	bm_log "Please wait >1min between SIM swaps (${sim_change_diff}s)"
	exit 1
fi

echo "$now" > /tmp/sim_change_start

bm_log "Starting SIM swap - disabling RF"

old_imei=$(READ_IMEI)
old_imsi=$(READ_IMSI)

answer=1
while [ "$answer" -eq 1 ]; do
	gl_modem AT AT+CFUN=4 | grep -q OK
	if [ $? -ne 0 ]; then
		bm_log "RF disable failed, retrying"
		CHECK_ABORT
	else
		answer=0
	fi
done

# Set interim random IMEI to prevent IMSI leak
if bm_can_write_imei; then
	timeout 15 python3 /lib/blue-merle/imei_generate.py -r
fi

bm_log "Stage 1 complete - swap SIM card, then pull switch"

echo done > /tmp/blue-merle-stage1
logger -p notice -t blue-merle-toggle "Finished with Stage 1"
