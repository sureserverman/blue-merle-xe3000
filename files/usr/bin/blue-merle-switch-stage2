#!/bin/sh

# blue-merle switch stage 2 for GL-XE3000 (Puli AX)

. /lib/blue-merle/functions.sh

rm -f /tmp/blue-merle-stage1

bm_log "Stage 2 - resetting modem"
sim_switch on

leak=0
until gl_modem -B $BM_MODEM_BUS AT AT+CFUN=0 | grep -q OK; do
	bm_log "CFUN=0 failed, retrying"
	sleep 1
done

until gl_modem -B $BM_MODEM_BUS AT AT+CFUN=4 | grep -q OK; do
	leak=1
	bm_log "CFUN=4 failed, retrying"
	sleep 1
done

if [ $leak -eq 1 ]; then
	bm_log "WARNING: Reset took longer than expected"
	sleep 3
fi

sleep 1
new_imsi=$(READ_IMSI)

if [ "$old_imsi" = "$new_imsi" ]; then
	bm_log "WARNING: Old IMSI equals new IMSI"
	sleep 3
fi

old_imei=$(READ_IMEI)

if bm_can_write_imei; then
	bm_log "Setting random IMEI"
	timeout 15 python3 /lib/blue-merle/imei_generate.py -r

	new_imei=$(READ_IMEI)
	if [ "$old_imei" = "$new_imei" ]; then
		bm_log "WARNING: Old IMEI equals new IMEI"
	else
		bm_log "IMEI changed: ${old_imei} -> ${new_imei}"
		mkdir -p /tmp/modem.1-1.2
		echo "$new_imei" > /tmp/modem.1-1.2/modem-imei
		if [ -d /root/esim ]; then
			echo "$new_imei" > /root/esim/imei
			shred -u /root/esim/log.txt 2>/dev/null
		fi
	fi
else
	bm_log "IMEI change not supported, skipping"
fi

logger -p notice -t blue-merle-toggle "Finished with Stage 2"

bm_log "Shutting down - change location before booting"
sleep 3

/sbin/poweroff
